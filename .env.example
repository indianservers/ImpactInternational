# Copy to .env for Docker Compose. Generate your own database password.
POSTGRES_PASSWORD=
PUBLIC_HOST=clubs.example.org
PUBLIC_ORIGIN=https://clubs.example.org
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# Native development uses PowerShell environment variables instead:
# ConnectionStrings__Database=Host=127.0.0.1;Port=55432;Database=clubs;Username=clubs
# ASPNETCORE_ENVIRONMENT=Development
# CLUBS_SEED_PASSWORD=<generate locally, minimum 12 characters>

# Phase 5: select a maintained Meta Graph API version; no guessed default.
META_GRAPH_VERSION=
# Set only after provider/domain sender verification; must match SMTP_FROM.
SMTP_VERIFIED_SENDER=

# Finance: bind aliases explicitly to a financial entity; secrets remain server-side.
# Finance__Gateways__club__EntityId=<financial-entity-uuid>
# Finance__Gateways__club__Provider=Stripe
# Finance__Gateways__club__SecretKey=<server-secret; test keys outside Production>
# Finance__Gateways__club__WebhookSecret=<endpoint-signing-secret>
# Finance__Gateways__club__ReturnUrl=https://your-domain.example/app/finance/member
# Register /api/v1/finance/webhooks/<financial-entity-uuid> at Stripe.
# Bind the alias in Financial settings only after configuring the corresponding account.

# Phase 8: optional server-only OpenAI routing; no default model and no browser keys.
# Intelligence__OpenAI__ApiKey=<server-secret>
# Intelligence__OpenAI__Model=<model enabled in your OpenAI project>
# Tenant policy and per-question acknowledgment are also required.
# Domains__ProvisionedHosts__0=your-verified-and-TLS-provisioned-host.example.org
# PublicOrigin=https://primary-application-host.example.org
# DataProtection__Path=<persistent private key-ring directory>
# Communications__StoragePath=<persistent private object directory>
